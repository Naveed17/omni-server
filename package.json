{
  "name": "omnipos-server",
  "version": "1.0.0",
  "description": "Omnipos Central Cloud Provider API & Admin Portal (NestJS + React Tailwind Vite)",
  "private": true,
  "scripts": {
    "dev": "concurrently -n api,admin -c blue,green \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:api": "nest start --watch",
    "dev:backend": "npm run dev:api",
    "dev:frontend": "vite",
    "build": "npm run build:api && npm run build:admin",
    "build:api": "nest build",
    "build:admin": "vite build",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/platform-express": "^11.0.12",
    "@tanstack/react-query": "^5.101.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.0",
    "lucide-react": "^0.511.0",
    "pg": "^8.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hot-toast": "^2.5.2",
    "react-router-dom": "^7.6.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.3",
    "@tailwindcss/vite": "^4.1.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.21.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^9.2.4",
    "tailwindcss": "^4.1.8",
    "typescript": "^5.8.2",
    "vite": "^6.4.3"
  }
}
